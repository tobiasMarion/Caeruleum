import { instanceOf, classType, relationType, numberType, stringType, subclassOf, domain, range } from '../../std/types'
import { document } from '../../std/organization'

export place: classType

export room: classType
    subclassOf = place

export pageNumber: relationType
    domain = room
    range = numberType

export leadsTo: relationType
    domain = place
    range = place

export preferredExit: relationType
    domain = room
    range = room

export url: relationType
    domain = document
    range = stringType
