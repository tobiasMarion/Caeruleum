import { instanceOf } from '../../std/types'
import { group, member, name } from '../../std/organization'
import { source, modality, possible } from '../../std/annotations'
import { room, pageNumber, leadsTo, preferredExit } from './vocabulary'
import * as sources from './sources'

room1: room
    name = 'Room 1'
    pageNumber = 1
    leadsTo = room20
        source = sources.room1Page
    leadsTo = room21
        source = sources.room1Page
    @exitTo26: leadsTo = room26
        source = sources.room1Page
    leadsTo = room41
        source = sources.room1Page
    @candidateExit: preferredExit = room26
        modality = possible
        source = sources.room1Interpretation

room20: room
    name = 'Room 20'
    pageNumber = 20

room21: room
    name = 'Room 21'
    pageNumber = 21

room26: room
    name = 'Room 26'
    pageNumber = 26

room41: room
    name = 'Room 41'
    pageNumber = 41

entranceInvestigation: group
    name = 'Investigating the entrance'
    member = room1
    member = @exitTo26
    member = @candidateExit
